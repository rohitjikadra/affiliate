API_ORIGIN=http://localhost:4000
# Production: public https origin (canonical, sitemap, Open Graph). Localhost is rejected when NODE_ENV=production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# Same value as backend REVALIDATE_SECRET. Lets the price worker refresh ISR pages after a successful fetch.
# Required in production on the API; set the same value here.
REVALIDATE_SECRET=
