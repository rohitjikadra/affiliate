NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/affiliate?schema=public
CORS_ORIGIN=http://localhost:3000
# Production: public https frontend origin (required; localhost is rejected).
ADMIN_PASSWORD=changeme
SESSION_SECRET=replace-with-a-long-random-string
AMAZON_ASSOCIATE_TAG=
TRUST_PROXY=0
# Production behind nginx/Caddy: TRUST_PROXY=1 (one hop). Do not raise this unless you know
# how many proxies overwrite X-Forwarded-For. Local development stays 0.
SITE_URL=http://localhost:3000
# Production: https public origin (not localhost). Required. Used for ISR revalidate and alert links.

# Amazon Creators API (official PA-API 5 replacement). Leave empty to run V1 on tagged /go links + manual prices.
# Do not scrape Amazon. Offer cache ~1h; other advertising content ~24h. ASINs may be stored.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_MARKETPLACE=www.amazon.in

# Public on-site price charts. Runtime reads PRICE_HISTORY_PUBLIC. Keep false until Indian
# counsel confirms Amazon-derived price charts may be shown. Do not invent seed history.
PRICE_HISTORY_PUBLIC=false

# Price-alert email. Create still succeeds without these; mailer logs email_skipped and does not send.
# Set both to actually deliver confirm / unsubscribe / trigger emails via Resend.
ALERT_FROM_EMAIL=
RESEND_API_KEY=

# On-demand ISR revalidate from the worker (Phase 6). Required in production; ≥32 characters.
REVALIDATE_SECRET=
